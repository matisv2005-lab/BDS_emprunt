generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Type_ticket {
  Emprunt
  Rendu
}

enum Role {
  Admin
  Utilisateur
}

model Utilisateur {
  id       String  @id @default(cuid())
  nom      String
  prenom   String
  email    String  @unique
  role     Role

  tickets  Ticket[]
  emprunts Emprunt[]
}

model Ticket {
  id        String   @id @default(cuid())
  type      Type_ticket
  date      DateTime @default(now())
  message   String?

  userId    String
  user      Utilisateur @relation(fields: [userId], references: [id])

  materiels Ticket_mat[]
}

model Ticket_mat {
  id           String @id @default(cuid())
  quantite     Int

  ticketId     String
  inventaireId String

  ticket       Ticket     @relation(fields: [ticketId], references: [id])
  inventaire   Inventaire @relation(fields: [inventaireId], references: [id])
}

model Emprunt {
  id        String   @id @default(cuid())
  date      DateTime @default(now())

  userId    String
  user      Utilisateur @relation(fields: [userId], references: [id])

  materiels Emprunt_mat[]
}

model Emprunt_mat {
  id           String @id @default(cuid())
  quantite     Int

  empruntId    String
  inventaireId String

  emprunt      Emprunt    @relation(fields: [empruntId], references: [id])
  inventaire   Inventaire @relation(fields: [inventaireId], references: [id])
}

model Inventaire {
  id          String @id @default(cuid())
  description String
  stock       Int
  info        String?

  tickets     Ticket_mat[]
  emprunts    Emprunt_mat[]
}